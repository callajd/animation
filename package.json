{
  "name": "sprinter-van-animation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "build:pages": "bun run typecheck && bun --bun vite build --mode github-pages",
    "preview": "bun --bun vite preview",
    "preview:pages": "bun --bun vite preview --mode github-pages",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.0.2",
    "lucide-react": "^1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "5.4.21",
    "@vitejs/plugin-react": "4.7.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/bun": "latest"
  }
}
